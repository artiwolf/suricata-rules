# GET: сообщение агента в параметре запроса (get_tasking / poll)
alert http any any -> any any (msg:"MYTHIC Medusa HTTP C2 - agent message in GET query (UUID-prefixed base64)"; flow:established,to_server; http.method; content:"GET"; http.uri; urilen:>90; pcre:"/[?&][A-Za-z0-9_.\-]{1,32}=[M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][AEIMQUYcgk][t][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][CSiy][01][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][L][TW][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][AEIMQUYcgk][t][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][A-Za-z0-9_\-]{40,}(?:={0,2}|(?:%3[dD]){0,2})(?:&|$)/"; classtype:trojan-activity; sid:9100001; rev:1; metadata:created_at 2026_10_28, mythic_profile http, confidence high;)

# POST: сообщение агента в теле (checkin / post_response / файлы)
alert http any any -> any any (msg:"MYTHIC Medusa HTTP C2 - agent message in POST body (UUID-prefixed base64)"; flow:established,to_server; http.method; content:"POST"; http.request_body; bsize:>90; pcre:"/^[M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][AEIMQUYcgk][t][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][CSiy][01][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][L][TW][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][AEIMQUYcgk][t][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][A-Za-z0-9+\/]{40,}/"; classtype:trojan-activity; sid:9100002; rev:1; metadata:created_at 2026_10_28, mythic_profile http, confidence high;)

# Ответ сервера Mythic: тело = base64(UUID|IV|ciphertext|HMAC)
alert http any any -> any any (msg:"MYTHIC Medusa HTTP C2 - server response with UUID-prefixed base64 body"; flow:established,to_client; http.stat_code; content:"200"; http.response_body; bsize:>90; pcre:"/^[M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][AEIMQUYcgk][t][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][CSiy][01][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][L][TW][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][AEIMQUYcgk][t][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][M-OYZ][2DGTWjmz][ABEFIJMNQRUVYZcdghkl][0-5h-mw-z][A-Za-z0-9+\/]{40,}/"; classtype:trojan-activity; sid:9100003; rev:1; metadata:created_at 2026_10_28, mythic_profile http, confidence high;)

# Ответ сервера: набор заголовков Mythic HTTP profile по умолчанию
alert http any any -> any any (msg:"MYTHIC HTTP C2 profile - default server response headers"; flow:established,to_client; http.header; content:"Server|3a 20|NetDNA-cache/2.2|0d 0a|"; content:"Content-Type|3a 20|application/javascript|3b 20|charset=utf-8, application/octet-stream|0d 0a|"; content:"Pragma|3a 20|no-cache|0d 0a|"; content:"Cache-Control|3a 20|max-age=0, no-cache|0d 0a|"; classtype:trojan-activity; sid:9100004; rev:1; metadata:created_at 2026_10_28, mythic_profile http, confidence medium;)

# Клиент: отпечаток Python http.client/urllib (Medusa) + длинный base64-параметр/тело
alert http any any -> any any (msg:"MYTHIC Medusa HTTP C2 - python client header fingerprint + long base64 payload (hunting)"; flow:established,to_server; http.header_names; pcre:"/^\r\nAccept-Encoding\r\n(?:Content-Type\r\nContent-Length\r\n)?Host\r\nUser-Agent\r\nConnection\r\n\r\n$/"; http.header; content:"Accept-Encoding|3a 20|identity|0d 0a|"; content:"Connection|3a 20|close|0d 0a|"; http.request_line; pcre:"/^(?:GET [^ ]*[?&][A-Za-z0-9_.\-]{1,32}=[A-Za-z0-9_%\-]{136,}|POST )/"; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9100005; rev:1; metadata:created_at 2026_10_28, mythic_profile http, confidence low;)
